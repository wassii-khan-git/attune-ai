# Copy this file to apps/api/.env and fill in real values. Never commit .env.
# The API validates these at startup and refuses to boot if any is missing or invalid.

# --- Runtime ---
# Required. In production the API also insists on https CORS origins and TRUST_PROXY_HOPS >= 1.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Database (Neon PostgreSQL) ---
# Pooled connection string (the host contains "-pooler"). Used by the running API.
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=
# Direct (non-pooled) connection string. Read only by the Prisma CLI for migrations.
DIRECT_URL=

# --- AI (Google Gemini via the Vercel AI SDK) ---
GOOGLE_GENERATIVE_AI_API_KEY=
# Gemini model id, used for both transcription and note drafting unless overridden below.
# Pick a current audio-capable model from https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=
# Optional. A different model for one of the two tasks. Blank means GEMINI_MODEL.
# The transcription model must accept audio.
GEMINI_TRANSCRIBE_MODEL=
GEMINI_NOTE_MODEL=
# Optional. A second model per task, tried once when the first is overloaded,
# unavailable or out of quota. Blank means the retry goes to the same model.
GEMINI_TRANSCRIBE_FALLBACK_MODEL=
GEMINI_NOTE_FALLBACK_MODEL=

# --- Field-level encryption (AES-256-GCM) ---
# 32 random bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Auth ---
# Signs the 15-minute access JWTs. At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# --- HTTP ---
# Comma-separated browser origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Reverse proxies in front of the API: 0 locally, 1 on Vercel. Rate limiting
# needs this to see the real client address instead of the proxy's. Must be >= 1 in production.
TRUST_PROXY_HOPS=0

# --- Web app proxy ---
# Optional locally. Set the same value as WEB_PROXY_SECRET in apps/web so the API
# can see each browser's real address behind the web app. At least 32 characters.
WEB_PROXY_SECRET=

# --- AI usage ---
# Generations allowed per UTC day across all users. Protects the shared model quota.
DAILY_GENERATION_BUDGET=100

# --- Scheduled jobs ---
# Secret Vercel Cron sends when it calls the retention endpoint. At least 32 characters.
CRON_SECRET=
