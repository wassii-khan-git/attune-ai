# Copy this file to apps/web/.env.local. Never commit .env.local.
# Every value is read on the server only. Only SITE_URL ends up in a page, as public links.

# Address of the API. The web app forwards every /v1 request to it, so the
# browser never calls the API directly.
API_URL=http://localhost:4000

# Optional. The public address of this site, which link previews on LinkedIn,
# Slack and X point at. Leave it out to use the deployed demo's address.
# SITE_URL=https://attune-ai-web.vercel.app

# Optional locally. Set the same value as WEB_PROXY_SECRET in apps/api so the API
# can see each browser's real address behind this app. At least 32 characters.
# WEB_PROXY_SECRET=
