{
  "name": "@attune/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas and inferred types shared by the API, web and mobile apps.",
  "type": "module",
  "sideEffects": [
    "./dist/zod-setup.js",
    "./dist/index.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
